# =====================================================================
# निवारण AI (Nivaran AI) — environment configuration
#
# Copy this file to `.env` (for docker-compose) and/or `frontend/.env.local`
# + `backend/.env` (for running services individually), then fill in real
# values where you have them.
#
# Nothing in this app hard-codes secrets. If an AI / Maps API key is left
# blank, the corresponding service automatically runs in DEMO MODE using
# clearly-labeled simulated data instead of failing.
# =====================================================================

# ---------------------------------------------------------------------
# General
# ---------------------------------------------------------------------
ENVIRONMENT=development

# ---------------------------------------------------------------------
# Frontend (Next.js) — anything prefixed NEXT_PUBLIC_ is sent to the browser.
# Never put a secret behind NEXT_PUBLIC_.
# ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Nivaran AI"
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Set to "true" to force the frontend to use built-in demo data even if an
# API is reachable. Useful for design/demo purposes without a backend.
NEXT_PUBLIC_DEMO_MODE=true

# Map provider. "osm" uses OpenStreetMap tiles via Leaflet and needs NO key.
# Switch to "mapbox" or "google" and supply a token to use richer tiles.
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Postgres connection used by the API and Alembic migrations
DATABASE_URL=postgresql+psycopg://nivaran:nivaran@localhost:5432/nivaran_ai
POSTGRES_USER=nivaran
POSTGRES_PASSWORD=nivaran
POSTGRES_DB=nivaran_ai

# Redis is used for Celery's broker + result backend
REDIS_URL=redis://localhost:6379/0

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# File uploads
MAX_UPLOAD_SIZE_MB=8
UPLOAD_DIR=./uploads

# ---------------------------------------------------------------------
# AI service abstraction
#
# Every AI capability (LLM, vision, embeddings, speech) is accessed through
# an internal service interface. Leaving a provider unset or set to "demo"
# makes that capability run in a clearly labeled DEMO/MOCK mode using
# deterministic, realistic sample output — the app stays fully usable
# without any external key, and demo output is never presented as a real
# AI verdict.
# ---------------------------------------------------------------------
AI_PROVIDER=demo            # demo | openai | anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

VISION_PROVIDER=demo        # demo | openai
SPEECH_PROVIDER=demo        # demo | openai

# Model names used only when the corresponding provider above is "openai"
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Used only when AI_PROVIDER=anthropic
ANTHROPIC_CHAT_MODEL=claude-3-5-haiku-latest

# ---------------------------------------------------------------------
# Priority engine weights (must sum to ~1.0). See backend/app/services/ai/priority_engine.py
# ---------------------------------------------------------------------
PRIORITY_WEIGHT_SEVERITY=0.30
PRIORITY_WEIGHT_SAFETY=0.25
PRIORITY_WEIGHT_AFFECTED=0.20
PRIORITY_WEIGHT_DURATION=0.15
PRIORITY_WEIGHT_LOCATION=0.10

# ---------------------------------------------------------------------
# Duplicate detection. See backend/app/services/ai/duplicate_detection.py
# ---------------------------------------------------------------------
# Radius (meters) within which two reports of the same category are considered
# potential duplicates.
DUPLICATE_RADIUS_METERS=350
# Minimum description-embedding cosine similarity (0-1) required, on top of the
# category+radius match, before two reports are grouped together.
DUPLICATE_SIMILARITY_THRESHOLD=0.20
# Number of recent "still present" confirmations on a resolved/citizen_verified
# issue that will automatically reopen it.
REOPEN_CONFIRMATION_THRESHOLD=3

# ---------------------------------------------------------------------
# Automation (Celery beat)
# ---------------------------------------------------------------------
FOLLOWUP_INACTIVITY_DAYS=7
ESCALATION_INACTIVITY_DAYS=14

# ---------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
