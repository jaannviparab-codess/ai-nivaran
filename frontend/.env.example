# =====================================================================
# Nivaran AI — frontend (Next.js) environment variables
#
# Local development: copy to `frontend/.env.local` (git-ignored).
# Vercel: add the same keys under Project → Settings → Environment Variables.
#
# Everything prefixed NEXT_PUBLIC_ is embedded into the browser bundle at
# BUILD time and is visible to anyone — never put a secret here. After
# changing a value on Vercel, redeploy so the new value is built in.
# AI keys, database URLs and SECRET_KEY belong on the BACKEND only.
# =====================================================================

# Display name used in the UI.
NEXT_PUBLIC_APP_NAME="Nivaran AI"

# FastAPI base URL including the /api prefix.
#   Local:       http://localhost:8000/api
#   Production:  https://<your-backend>.onrender.com/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# "true" (default when unset) = built-in simulated data; the backend is never called
#   and login accepts any credentials. Good for a standalone showcase deploy.
# "false" = use the real FastAPI backend. On Vercel the build fails fast if
#   NEXT_PUBLIC_API_BASE_URL is missing or points to localhost.
NEXT_PUBLIC_DEMO_MODE=true

# Map tiles. "osm" = OpenStreetMap via Leaflet, no key required.
NEXT_PUBLIC_MAP_PROVIDER=osm
