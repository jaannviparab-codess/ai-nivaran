# --- Node / Frontend ---
node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.env.local
frontend/next-env.d.ts
*.tsbuildinfo
npm-debug.log*

# --- Python / Backend ---
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/venv/
backend/*.egg-info/
backend/.pytest_cache/
backend/.mypy_cache/
backend/uploads/
backend/*.db

# --- Env (real values never committed; the documented templates are) ---
.env
.env.local
.env.*.local
.env.*
!.env.example

# --- Secrets / credentials ---
*.pem
*.key
*.p12

# --- Local databases & user uploads (may contain private data) ---
*.db
*.sqlite
*.sqlite3
**/uploads/

# --- Deployment tooling ---
.vercel/

# --- Local AI-assistant / tool settings ---
.claude/

# --- OS / Editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Docker ---
docker/volumes/

# --- Logs ---
*.log
